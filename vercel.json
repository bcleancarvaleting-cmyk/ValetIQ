{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": false
    },
    {
      "source": "/account",
      "destination": "/account/",
      "permanent": false
    },
    {
      "source": "/gift",
      "destination": "/?gift=open",
      "permanent": false
    },
    {
      "source": "/gifts",
      "destination": "/?gift=open",
      "permanent": false
    },
    {
      "source": "/gift/:amt",
      "destination": "/?gift=:amt",
      "permanent": false
    },
    {
      "source": "/voucher/:code",
      "destination": "/?voucher=:code",
      "permanent": false
    },
    {
      "source": "/book",
      "destination": "/?book=1",
      "permanent": false
    },
    {
      "source": "/cert/:code",
      "destination": "/?cert=:code",
      "permanent": false
    },
    {
      "source": "/fleet",
      "destination": "/fleet-valeting",
      "permanent": false
    },
    {
      "source": "/business",
      "destination": "/fleet-valeting",
      "permanent": false
    },
    {
      "source": "/car-valeting",
      "destination": "/areas",
      "permanent": false
    },
    {
      "source": "/car-detailing",
      "destination": "/areas",
      "permanent": false
    },
    {
      "source": "/ceramic-coating",
      "destination": "/areas",
      "permanent": false
    },
    {
      "source": "/book/:svc",
      "destination": "/?book=1&svc=:svc",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/prototype/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/admin/"
        }
      ]
    },
    {
      "source": "/account/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/account/"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/cal/:id",
      "destination": "https://tigznsqtesgofvoflmem.supabase.co/functions/v1/calendar?b=:id"
    }
  ]
}